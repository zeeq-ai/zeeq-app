{
  "AppSettings": {
    "Platform": {
      "SystemAdminSubjects": ["google:YOUR_SUBJECT"],
      "OrganizationActivationKeysEnabled": true
    },
    "Auth": {
      "Providers": [{
        "Name": "google", "DisplayName": "Google",
        "ClientId": "YOUR_CLIENT_ID", "ClientSecret": "YOUR_CLIENT_SECRET",
        "IssuerUri": "https://accounts.google.com",
        "ServerCallbackUri": "https://YOUR_HOSTNAME/auth/callback/google",
        "Scopes": ["openid", "profile", "email"]
      }],
      "OpenIddict": {
        "SigningCertificateBase64": "BASE64_PFX", "SigningCertificatePassword": "PFX_PASSWORD",
        "EncryptionCertificateBase64": "BASE64_PFX", "EncryptionCertificatePassword": "PFX_PASSWORD"
      }
    },
    "GitHub": {
      "AppId": "YOUR_APP_ID", "ClientId": "YOUR_GITHUB_APP_CLIENT_ID", "AppSlug": "YOUR_APP_SLUG",
      "PrivateKeyPem": "YOUR_PEM", "WebhookSecret": "YOUR_WEBHOOK_SECRET", "AlwaysUseGhTokenForSync": false
    },
    "CodeReview": { "ReviewRequestLinkEncryptionKey": "BASE64_RANDOM_KEY" },
    "Documents": { "LibraryExportSigningKey": "BASE64_RANDOM_KEY" },
    "Llm": {
      "Models": { "Fast": { "Provider": "Fireworks", "Model": "YOUR_MODEL", "Endpoint": "https://api.fireworks.ai/inference/v1", "ApiKey": "YOUR_API_KEY" } },
      "Embeddings": { "Enabled": false }
    }
  }
}
